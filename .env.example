# Cursor Team Admin API key.
# The key must have read:* permissions.
CURSOR_API_KEY=PASTE_YOUR_CURSOR_TEAM_API_KEY_HERE

# Comma-separated exact Team Directory Group names.
# Or GROUP_NAMES=* (or auto) to track ALL directory groups dynamically (renames can't break refresh).
GROUP_NAMES=*

# Optional comma-separated names to skip in auto mode.
EXCLUDE_GROUP_NAMES=

# How often the collector refreshes the current snapshot.
# Cursor recommends polling usage/spend data at most once per hour.
COLLECTION_INTERVAL_SECONDS=3600

# Display timezone for collector logs. Fixed UTC+4 GST (Dubai has no DST).
TZ=Asia/Dubai

# Local Grafana login.
GRAFANA_ADMIN_PASSWORD=change-me-now

REQUEST_TIMEOUT_SECONDS=30
