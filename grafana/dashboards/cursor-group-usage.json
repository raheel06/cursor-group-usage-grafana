      "targets": [
        {
          "format": "table",
          "rawSql": "WITH total_spend AS (SELECT COALESCE(SUM(spend),0) AS spend FROM cursor_member_current), total_limit AS (SELECT COALESCE(SUM(user_max_limit),0) AS lim FROM (SELECT user_id, MAX(GREATEST(COALESCE(group_limit_per_user,0), COALESCE(effective_limit,0))) AS user_max_limit FROM cursor_group_member_current WHERE group_id != '__unassigned__' GROUP BY user_id UNION ALL SELECT user_id, GREATEST(40, COALESCE(effective_limit,0)) FROM cursor_group_member_current WHERE group_id = '__unassigned__') t) SELECT CASE WHEN (SELECT SUM(lim) FROM total_limit) = 0 THEN 0 ELSE (SELECT spend FROM total_spend) / (SELECT SUM(lim) FROM total_limit) * 100 END AS value;",
          "refId": "A"
        }
      ],
      "title": "Overall Utilization",
      "type": "stat"
