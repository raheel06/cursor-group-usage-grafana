      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  g.group_name AS \"Group\",\n  g.member_count AS \"Members\",\n  COALESCE(p.billed_count, 0) AS \"Billed Members\",\n  ROUND(COALESCE(p.billed_count, 0)::numeric / NULLIF((SELECT COUNT(DISTINCT user_id) FROM cursor_group_member_current), 0) * 100, 1) AS \"User Assignment %\",\n  g.group_limit_per_user AS \"Limit / User\",\n  COALESCE(p.billed_limit, 0) AS \"Assigned Limit\",\n  COALESCE(p.billed_spend, 0) AS \"Current Consumption\",\n  CASE WHEN COALESCE(p.billed_limit, 0) = 0 THEN NULL ELSE COALESCE(p.billed_limit, 0) - COALESCE(p.billed_spend, 0) END AS \"Remaining\",\n  CASE WHEN COALESCE(p.billed_limit, 0) = 0 THEN NULL ELSE ROUND(COALESCE(p.billed_spend, 0) / COALESCE(p.billed_limit, 0) * 100, 1) END AS \"Utilization %\",\n  g.members_over_80 AS \">80%\",\n  g.refreshed_at AS \"Last Updated\"\nFROM cursor_group_current g\nLEFT JOIN (\n  SELECT group_id,\n    COUNT(*) AS billed_count,\n    SUM(group_limit) AS billed_limit,\n    SUM(spend) AS billed_spend\n  FROM (\n    SELECT m.group_id, m.user_id,\n      GREATEST(COALESCE(m.group_limit_per_user,0), COALESCE(m.effective_limit,0)) AS group_limit,\n      m.spend,\n      ROW_NUMBER() OVER (PARTITION BY m.user_id ORDER BY GREATEST(COALESCE(m.group_limit_per_user,0), COALESCE(m.effective_limit,0)) DESC, COALESCE(m.group_limit_per_user,0) DESC, m.group_id) AS rn\n    FROM cursor_group_member_current m\n    WHERE m.group_id != '__unassigned__'\n  ) t\n  WHERE rn = 1\n  GROUP BY group_id\n) p ON p.group_id = g.group_id\nWHERE g.group_id != '__unassigned__'\nUNION ALL\nSELECT\n  'unassigned-users' AS \"Group\",\n  u.member_count AS \"Members\",\n  u.billed_count AS \"Billed Members\",\n  ROUND(u.billed_count::numeric / NULLIF((SELECT COUNT(DISTINCT user_id) FROM cursor_group_member_current), 0) * 100, 1) AS \"User Assignment %\",\n  40 AS \"Limit / User\",\n  u.billed_limit AS \"Assigned Limit\",\n  u.billed_spend AS \"Current Consumption\",\n  u.billed_limit - u.billed_spend AS \"Remaining\",\n  ROUND(u.billed_spend / NULLIF(u.billed_limit, 0) * 100, 1) AS \"Utilization %\",\n  0 AS \">80%\",\n  NOW() AS \"Last Updated\"\nFROM (\n  SELECT COUNT(*) AS member_count, COUNT(*) AS billed_count, SUM(GREATEST(40, COALESCE(effective_limit, 0))) AS billed_limit, SUM(spend) AS billed_spend\n  FROM cursor_group_member_current\n  WHERE group_id = '__unassigned__'\n) u\nORDER BY \"Utilization %\" DESC NULLS LAST;",
          "refId": "A"
        }
      ],
      "title": "Cursor Group Consumption",
      "type": "table"
    },
