    {
      "type": "table",
      "title": "Multi-Group Users",
      "description": "Users assigned to more than one tracked directory group. Shows all groups per user and their applicable limit in each.",
      "id": 8,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "postgres",
        "uid": "cursor-postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT u.email AS \"User\", u.display_name AS \"Name\", u.member_count AS \"Group Count\", u.groups AS \"Groups\", mc.spend AS \"Current Consumption\", u.max_limit AS \"Max Applicable Limit\" FROM (SELECT email, display_name, COUNT(*) AS member_count, STRING_AGG(group_name, ', ' ORDER BY group_name) AS groups, MAX(applicable_limit) AS max_limit FROM cursor_user_report WHERE group_id != '__unassigned__' GROUP BY email, display_name HAVING COUNT(*) > 1) u JOIN cursor_member_current mc ON mc.email = u.email ORDER BY u.member_count DESC, u.email;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Current Consumption"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max Applicable Limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Unassigned Users",
      "description": "Members in no tracked directory group (group_id __unassigned__). Same spend source as other tables.",
